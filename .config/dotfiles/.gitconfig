[status]
	showUntrackedFiles = true
	relativePaths = false
[submodule]
	recurse = false
[my]
	defaultBranchProtection = false
[alias]
	console = !irb -r ~/.local/share/dotfiles/package
	edit = !${EDITOR%% *} +0G
	update = !git pull && ./setup
	cl = !"f() { >&2 echo \"dotfiles clean disabled\"; return 1;}; f"
